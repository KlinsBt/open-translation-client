<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE martif SYSTEM "TBXBasiccoreStructV02.dtd">
<martif type="TBX-Basic" xml:lang="en">
  <martifHeader>
    <fileDesc><titleStmt><title>Legacy terminology</title></titleStmt><sourceDesc><p>OpenTLC ID: 72</p></sourceDesc></fileDesc>
  </martifHeader>
  <text><body>
    <termEntry id="legacy-file">
      <descrip type="subjectField">computing</descrip>
      <langSet xml:lang="en-US">
        <descripGrp><descrip type="definition">A named collection of data.</descrip></descripGrp>
        <tig id="legacy-en"><term>file</term><termNote type="partOfSpeech">noun</termNote></tig>
        <ntig id="legacy-en-alt">
          <termGrp><term>computer file</term><termNote type="administrativeStatus">admittedTerm-admn-sts</termNote></termGrp>
          <admin type="source">Legacy CAT export</admin>
        </ntig>
      </langSet>
      <langSet xml:lang="de-DE"><tig id="legacy-de"><term>Datei</term></tig></langSet>
      <ref type="crossReference" target="legacy-folder">related concept</ref>
    </termEntry>
    <termEntry id="legacy-folder">
      <langSet xml:lang="en-US"><tig><term>folder</term></tig></langSet>
      <langSet xml:lang="de-DE"><tig><term>Ordner</term></tig></langSet>
    </termEntry>
  </body></text>
</martif>
