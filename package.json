{
	"name": "translation-client",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.20.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "npm run lint:format && npm run lint:logic",
		"lint:format": "prettier --check .",
		"lint:logic": "eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:browser": "vitest --config vite.browser.config.ts --run",
		"test:browser:smoke": "vitest --config vite.browser.config.ts --run src/routes/catApplication.browser.spec.ts",
		"test": "npm run test:unit -- --run && npm run test:browser",
		"verify": "npm run lint && npm run check && npm test && npm run build"
	},
	"devDependencies": {
		"@fontsource/fira-mono": "^5.0.0",
		"@huggingface/transformers": "^4.2.0",
		"@neoconfetti/svelte": "^2.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@typescript-eslint/parser": "^8.46.3",
		"@vitest/browser-playwright": "^4.1.11",
		"@xmldom/xmldom": "^0.8.10",
		"eslint": "^9.39.1",
		"eslint-plugin-svelte": "^3.12.4",
		"happy-dom": "^20.11.2",
		"playwright": "^1.62.1",
		"postal-mime": "^2.7.3",
		"prettier": "3.4.2",
		"prettier-plugin-svelte": "3.3.2",
		"svelte": "^5.56.10",
		"svelte-check": "^4.0.0",
		"tslib": "^2.4.1",
		"typescript": "5.7.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"xmllint-wasm": "^5.3.0"
	},
	"type": "module",
	"dependencies": {
		"@jonahschulte/rtf-toolkit": "^0.5.0",
		"@msgpack/msgpack": "^3.0.0-beta2",
		"ag-psd": "^31.0.2",
		"cfb": "^1.2.2",
		"docx": "^8.5.0",
		"file-saver": "^2.0.5",
		"jszip": "^3.10.1",
		"mammoth": "^1.8.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^6.2.108",
		"reamkit": "^1.29.0",
		"tesseract.js": "^7.0.0",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"yaml": "^2.9.0"
	},
	"overrides": {
		"adm-zip": "^0.6.0",
		"cookie": "0.7.2",
		"sharp": "^0.35.0"
	}
}
