{
	"name": "translation-client",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.20.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test:browser": "vitest --config vite.browser.config.ts --run",
		"test": "npm run test:unit -- --run && npm run test:browser",
		"verify": "npm run lint && npm run check && npm test && npm run build"
	},
	"devDependencies": {
		"@fontsource/fira-mono": "^5.0.0",
		"@neoconfetti/svelte": "^2.0.0",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@vitest/browser": "^2.1.9",
		"@xmldom/xmldom": "^0.8.10",
		"happy-dom": "^20.11.2",
		"playwright": "^1.62.1",
		"prettier": "^3.3.2",
		"prettier-plugin-svelte": "^3.2.6",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^5.4.11",
		"vitest": "^2.0.4",
		"xmllint-wasm": "^5.3.0"
	},
	"type": "module",
	"dependencies": {
		"@msgpack/msgpack": "^3.0.0-beta2",
		"docx": "^8.5.0",
		"file-saver": "^2.0.5",
		"jszip": "^3.10.1",
		"mammoth": "^1.8.0",
		"pdfjs-dist": "^6.2.108",
		"yaml": "^2.9.0"
	}
}
